{
  "name": "issueflow-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage --ignore-pattern playwright-report --ignore-pattern test-results",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "npm run test:coverage:product && npm run test:coverage:exercises",
    "test:coverage:product": "vitest run src contract-tests --coverage",
    "test:coverage:exercises": "vitest run --coverage --config vitest.exercises.config.ts",
    "test:contract:corpus": "vitest run contract-tests/dual-backend",
    "test:contract:http": "node contract-tests/dual-backend/run-http-parity.mjs",
    "test:contract:local": "playwright test e2e/api-contract.spec.ts --project=chromium",
    "test:contract:consumers": "npm run test:contract:local && dotnet test ../backend/IssueFlow.Api.Tests/IssueFlow.Api.Tests.csproj --filter FullyQualifiedName~SharedContractCorpusTests",
    "test:contract:dual": "npm run test:contract:corpus && npm run build && npm run test:contract:http",
    "exercise:test": "node scripts/run-ts-exercise.mjs",
    "exercise:typecheck": "tsc --noEmit --incremental false -p tsconfig.exercises.json",
    "exercise:verify": "node scripts/run-ts-exercise.mjs --verify",
    "exercise:react": "node scripts/run-react-exercise.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=chromium",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "lighthouse": "13.4.1",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
