{
  "schemaVersion": 1,
  "login": {
    "path": "/api/auth/login",
    "body": {
      "email": "demo@issueflow.dev",
      "password": "issueflow"
    },
    "expect": { "status": 200 }
  },
  "logout": {
    "method": "POST",
    "path": "/api/auth/logout",
    "expect": { "status": 204 }
  },
  "cases": [
    {
      "id": "R01",
      "title": "健康检查返回 JSON",
      "auth": false,
      "request": { "method": "GET", "path": "/api/health" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "requiredJsonPaths": ["status"]
      }
    },
    {
      "id": "R02",
      "title": "默认列表返回分页 envelope",
      "auth": false,
      "request": { "method": "GET", "path": "/api/issues?page=1&pageSize=5" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "requiredJsonPaths": ["items", "page", "pageSize", "total"]
      }
    },
    {
      "id": "R03",
      "title": "成员列表返回数组",
      "auth": false,
      "request": { "method": "GET", "path": "/api/members" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "jsonKind": "array"
      }
    },
    {
      "id": "R04",
      "title": "未知 Issue 返回 Problem Details",
      "auth": false,
      "request": { "method": "GET", "path": "/api/issues/999999" },
      "expect": {
        "status": 404,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "R05",
      "title": "非法查询返回 400",
      "auth": false,
      "request": {
        "method": "GET",
        "path": "/api/issues?page=0&pageSize=101&status=waiting"
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status", "errors"]
      }
    },
    {
      "id": "R06",
      "title": "已知 Issue 保持共享 wire shape",
      "auth": false,
      "request": { "method": "GET", "path": "/api/issues/248" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "requiredJsonPaths": [
          "id",
          "key",
          "title",
          "status",
          "priority",
          "reporter",
          "tags"
        ]
      }
    },
    {
      "id": "W01",
      "title": "匿名创建返回 401",
      "auth": false,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": "{{uniqueTitle}}",
          "description": "",
          "status": "open",
          "priority": "high",
          "assigneeId": null,
          "tags": [],
          "dueDate": null
        }
      },
      "expect": {
        "status": 401,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "W02",
      "title": "演示账号可以登录",
      "auth": false,
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": { "email": "demo@issueflow.dev", "password": "issueflow" }
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "requiredJsonPaths": ["email", "displayName", "role"]
      }
    },
    {
      "id": "W03",
      "title": "合法 Issue 可以创建",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": "{{uniqueTitle}}",
          "description": "Shared contract corpus",
          "status": "open",
          "priority": "high",
          "assigneeId": 2,
          "tags": ["contract"],
          "dueDate": null
        }
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "requiredJsonPaths": ["id", "key", "title", "status", "reporter"]
      },
      "cleanup": {
        "method": "DELETE",
        "path": "/api/issues/{{response.id}}",
        "expect": { "status": 204 }
      }
    },
    {
      "id": "W04",
      "title": "空标题返回字段错误",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": " ",
          "description": "",
          "status": "open",
          "priority": "high",
          "assigneeId": null,
          "tags": [],
          "dueDate": null
        }
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status", "errors"]
      }
    },
    {
      "id": "W05",
      "title": "未知枚举返回 400",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": "Invalid status",
          "description": "",
          "status": "waiting",
          "priority": "high",
          "assigneeId": null,
          "tags": [],
          "dueDate": null
        }
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "W06",
      "title": "不存在的日期返回 400",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": "Impossible date",
          "description": "",
          "status": "open",
          "priority": "high",
          "assigneeId": null,
          "tags": [],
          "dueDate": "2099-02-30"
        }
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "S01",
      "title": "畸形 JSON 返回 400 而不是 500",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "rawBody": "{\"title\":"
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "S02",
      "title": "null body 返回 400 而不是 500",
      "auth": true,
      "request": { "method": "POST", "path": "/api/issues", "rawBody": "null" },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "S03",
      "title": "数组 body 返回 400 而不是 500",
      "auth": true,
      "request": { "method": "POST", "path": "/api/issues", "rawBody": "[]" },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "S04",
      "title": "标量 body 返回 400 而不是 500",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "rawBody": "\"issue\""
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "S05",
      "title": "更新未知 Issue 返回 404",
      "auth": true,
      "request": {
        "method": "PATCH",
        "path": "/api/issues/999999",
        "body": { "status": "resolved" }
      },
      "expect": {
        "status": 404,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "S06",
      "title": "空评论返回 400",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues/248/comments",
        "body": { "body": "" }
      },
      "expect": {
        "status": 400,
        "contentType": "application/problem+json",
        "requiredJsonPaths": ["title", "status"]
      }
    },
    {
      "id": "R07",
      "title": "搜索结果保持总数与标题排序",
      "auth": false,
      "request": {
        "method": "GET",
        "path": "/api/issues?page=1&pageSize=10&search=Refresh%20session&sortBy=title&sortDirection=asc"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "requiredJsonPaths": ["items.0.id", "items.0.title", "total"],
        "jsonValues": {
          "total": 3,
          "items.0.id": 248,
          "items.0.title": "Refresh session after returning from sleep"
        }
      }
    },
    {
      "id": "R08",
      "title": "状态优先级与负责人筛选可以组合",
      "auth": false,
      "request": {
        "method": "GET",
        "path": "/api/issues?page=1&pageSize=10&status=closed&priority=low&assigneeId=6&sortBy=title&sortDirection=asc"
      },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "requiredJsonPaths": [
          "items.0.id",
          "items.0.status",
          "items.0.priority",
          "items.0.assignee.id",
          "total"
        ],
        "jsonValues": {
          "total": 8,
          "items.0.id": 204,
          "items.0.status": "closed",
          "items.0.priority": "low",
          "items.0.assignee.id": 6
        }
      }
    },
    {
      "id": "W07",
      "title": "PATCH 区分省略、null 与具体值",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": "{{uniqueTitle}}",
          "description": "PATCH tri-state contract",
          "status": "open",
          "priority": "medium",
          "assigneeId": 2,
          "tags": ["contract", "patch"],
          "dueDate": "2099-12-31"
        }
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "requiredJsonPaths": ["id", "status", "assignee.id", "dueDate"]
      },
      "followUps": [
        {
          "id": "omit",
          "request": {
            "method": "PATCH",
            "path": "/api/issues/{{response.id}}",
            "body": { "status": "in_progress" }
          },
          "expect": {
            "status": 200,
            "contentType": "application/json",
            "jsonValues": {
              "status": "in_progress",
              "assignee.id": 2,
              "dueDate": "2099-12-31"
            }
          }
        },
        {
          "id": "null",
          "request": {
            "method": "PATCH",
            "path": "/api/issues/{{response.id}}",
            "body": { "assigneeId": null, "dueDate": null }
          },
          "expect": {
            "status": 200,
            "contentType": "application/json",
            "jsonValues": {
              "status": "in_progress",
              "assignee": null,
              "dueDate": null
            }
          }
        },
        {
          "id": "value",
          "request": {
            "method": "PATCH",
            "path": "/api/issues/{{response.id}}",
            "body": { "assigneeId": 1, "dueDate": "2099-11-30" }
          },
          "expect": {
            "status": 200,
            "contentType": "application/json",
            "jsonValues": {
              "status": "in_progress",
              "assignee.id": 1,
              "dueDate": "2099-11-30"
            }
          }
        }
      ],
      "cleanup": {
        "method": "DELETE",
        "path": "/api/issues/{{response.id}}",
        "expect": { "status": 204 }
      }
    },
    {
      "id": "W08",
      "title": "评论可以创建、删除且不能重复删除",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues/248/comments",
        "body": { "body": "Contract comment {{uniqueTitle}}" }
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "requiredJsonPaths": ["id", "issueId", "body"],
        "jsonValues": { "issueId": 248 }
      },
      "followUps": [
        {
          "id": "delete",
          "request": {
            "method": "DELETE",
            "path": "/api/issues/248/comments/{{response.id}}"
          },
          "expect": { "status": 204, "jsonKind": "empty" }
        },
        {
          "id": "delete-again",
          "request": {
            "method": "DELETE",
            "path": "/api/issues/248/comments/{{response.id}}"
          },
          "expect": {
            "status": 404,
            "contentType": "application/problem+json",
            "requiredJsonPaths": ["title", "status"]
          }
        }
      ]
    },
    {
      "id": "W09",
      "title": "Issue 删除后无法再次读取",
      "auth": true,
      "request": {
        "method": "POST",
        "path": "/api/issues",
        "body": {
          "title": "{{uniqueTitle}}",
          "description": "Delete lifecycle contract",
          "status": "open",
          "priority": "high",
          "assigneeId": null,
          "tags": ["contract", "delete"],
          "dueDate": null
        }
      },
      "expect": {
        "status": 201,
        "contentType": "application/json",
        "requiredJsonPaths": ["id", "key", "title"]
      },
      "followUps": [
        {
          "id": "delete",
          "request": {
            "method": "DELETE",
            "path": "/api/issues/{{response.id}}"
          },
          "expect": { "status": 204, "jsonKind": "empty" }
        },
        {
          "id": "read-after-delete",
          "request": { "method": "GET", "path": "/api/issues/{{response.id}}" },
          "expect": {
            "status": 404,
            "contentType": "application/problem+json",
            "requiredJsonPaths": ["title", "status"]
          }
        }
      ]
    }
  ]
}
